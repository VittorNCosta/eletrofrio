ELETROFRIO_API_URL=https://credenciamento.eletrofrio.com.br:5900/galileo/api/api_hackathon

# MongoDB Atlas (cluster compartilhado da equipe)
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=eletrofrio

# LLM provider: "ollama" (local, sem custo), "openai", ou vazio (extractive sem IA)
LLM_PROVIDER=ollama

# Ollama local (necessário Ollama Desktop instalado: https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (alternativa paga — preencha se LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

TEAM_NAME=AI Team
TEMPERATURE_THRESHOLD=10.0
ALARM_REPEAT_THRESHOLD=3
