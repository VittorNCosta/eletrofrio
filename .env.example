ELETROFRIO_API_URL=https://credenciamento.eletrofrio.com.br:5900/galileo/api/api_hackathon

# MongoDB Atlas (cluster compartilhado da equipe)
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=eletrofrio

# LLM provider: "groq" (grátis na nuvem), "ollama" (local), "openai", ou vazio (extractive sem IA)
LLM_PROVIDER=groq

# Groq (LLM grátis na nuvem — crie a chave em https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local (necessário Ollama Desktop instalado: https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (alternativa paga — preencha se LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# URL pública da app (usada no link do gráfico enviado no WhatsApp).
# No Render pode deixar vazio: ele injeta RENDER_EXTERNAL_URL automaticamente.
PUBLIC_BASE_URL=https://eletrofrio.onrender.com

# WhatsApp / alertas ao cliente (provedor CallMeBot — grátis)
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=callmebot
# Crie a apikey ativando o bot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_APIKEY=
# Demo: redireciona todos os alertas para este número (já opt-in no CallMeBot).
# A mensagem segue citando a loja/cliente real. Deixe vazio em produção.
WHATSAPP_OVERRIDE_PHONE=
WHATSAPP_COUNTRY_CODE=55

TEAM_NAME=AI Team
TEMPERATURE_THRESHOLD=10.0
ALARM_REPEAT_THRESHOLD=3
